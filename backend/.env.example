# SpeechMate backend settings. Copy to .env (./start.sh does it for you).
# Every key is optional: without them the app runs on local models and offline fallbacks.

# ── Keys ─────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
# OpenAI key, or a Groq key (gsk_...) with OPENAI_BASE_URL below
OPENAI_API_KEY=
# Only to clone your own narration voice
ELEVENLABS_API_KEY=

# ── Speech-to-text ───────────────────────────────────
# Cloud API (OPENAI_API_KEY + OPENAI_BASE_URL). Audio leaves this machine.
# Groq: https://api.groq.com/openai/v1 with TRANSCRIPTION_MODEL=whisper-large-v3
# OPENAI_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1
# Empty = auto-detect (best for Manglish); or force en / ms
STT_LANGUAGE=
# false = skip all local models even when installed
USE_LOCAL_ML=true

# ── LLM ──────────────────────────────────────────────
# Gemini (OpenAI-compatible). Key: https://aistudio.google.com/apikey. The same model reads slide images.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SEC=120

# ── Voices ───────────────────────────────────────────
# AI partner, local Kokoro: http://kokoro:8880/v1 (bundled)
# TTS_BASE_URL=
# af_heart, af_bella, am_michael, bf_emma, bm_george…
LOCAL_TTS_VOICE=af_heart
# Narrator: husein, idayu, haqkiem, singaporean, …
MALAYSIAN_TTS_VOICE=husein
# Malaysian TTS for the partner too: auto = only on an NVIDIA GPU
LIVE_TTS_LOCAL=auto
# Cloud TTS (OpenAI) fallback
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
COACH_TTS_VOICE=nova
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── App ──────────────────────────────────────────────
# DATABASE_URL, STORAGE_BASE_PATH and CORS_ORIGINS are set by docker compose
DATABASE_URL=postgresql+asyncpg://speechmate:speechmate_password@localhost/speechmate_db
STORAGE_BASE_PATH=./storage
CORS_ORIGINS=["http://localhost:3000"]
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
MAX_CONCURRENT_JOBS=2
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SCRIPT_MIN_WORDS=60
SCRIPT_MAX_WORDS=100
# FFMPEG_BIN=ffmpeg
# LIBREOFFICE_BIN=libreoffice
# ESPEAK_BIN=espeak-ng
