# SpeechMate Backend — Environment Variables
# Copy this file to .env and fill in your values. Every AI key is optional:
# without keys the whole pipeline still runs using offline fallbacks.

# ── Database (async Postgres via asyncpg) ────────────────────────────────────
# Ignored under docker-compose (it points the API at the compose "db" service).
DATABASE_URL=postgresql+asyncpg://speechmate:speechmate_password@localhost/speechmate_db

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BASE_PATH=./storage

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
# How many pipelines (ideal video, coach or live analysis) may run at the same time
MAX_CONCURRENT_JOBS=2

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI (VLM scripts, standard TTS voice, Whisper, coach feedback, chat) ──
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (e.g. Qwen2.5-VL via DashScope, like the paper)
# OPENAI_BASE_URL=
# Model names: OpenAI ones by default; use Ollama tags with LLM_BASE_URL (see "Local LLM" below)
VLM_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TRANSCRIPTION_MODEL=whisper-1
# Voice of the live-session AI partner (/api/tts/speak)
COACH_TTS_VOICE=nova

# ── Local LLM (optional) ──────────────────────────────────────────────────────
# Send chat, coaching feedback and slide scripts to a local OpenAI-compatible
# server instead of OpenAI. Speech (TTS, Whisper) is unaffected. For Ollama:
#   LLM_BASE_URL=http://ollama:11434/v1               # the compose "ollama" service (./start.sh starts it)
#   LLM_BASE_URL=http://host.docker.internal:11434/v1 # Ollama installed on your own machine (Windows/Mac/Linux)
#   LLM_MODEL=qwen2.5:3b          # text: coach feedback, chat, AI partner (7b if you have ≥16 GB RAM)
#   VLM_MODEL=qwen2.5vl:3b        # vision: reads each slide image to write its script (7b if ≥16 GB RAM)
# LLM_BASE_URL=
# LLM_API_KEY=
LLM_TIMEOUT_SEC=300

# ── Narration voice: local Malaysian TTS (mesolitica/Malaysian-TTS-0.6B-v1) ──
# The default narrator for presentation videos (needs requirements-ml.txt).
# Voices: husein, idayu, haqkiem, singaporean, singlish-speaker2050,
#         singlish-speaker2202, DisfluencySpeech (chosen per deck in the app)
MALAYSIAN_TTS_VOICE=husein
# Also voice the live AI partner with it? auto = only on an NVIDIA GPU (too slow on CPU)
LIVE_TTS_LOCAL=auto

# ── ElevenLabs (OPTIONAL: only for cloning your own voice; needs Instant Voice Cloning)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Live-session analysis (local models from requirements-ml.txt) ───────────
# Set to false to skip local models even when installed (uses the OpenAI API for ASR)
USE_LOCAL_ML=true
# faster-whisper size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small

# ── Ideal Presentation Agent ─────────────────────────────────────────────────
SCRIPT_MIN_WORDS=60
SCRIPT_MAX_WORDS=100

# ── Binaries (override if not on PATH) ───────────────────────────────────────
# FFMPEG_BIN=ffmpeg
# LIBREOFFICE_BIN=libreoffice
# ESPEAK_BIN=espeak-ng
